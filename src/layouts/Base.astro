---
const {
  title,
  back,
  pdf,
  description = 'Plain-English study notes for EPBM-32, with diagrams, practice quizzes and downloadable PDFs. Free to read.',
  image = '/og/default.png',
} = Astro.props;
const pageTitle = title ? `${title} · EPBM Library` : 'EPBM Library';
const site = Astro.site ?? new URL('https://library.girder.in');
const canonical = new URL(Astro.url.pathname, site).href;
const imageUrl = new URL(image, site).href;

const themes = [
  { id: 'light', label: 'Light', bg: '#FDFCF9', fg: '#1A1C1E' },
  { id: 'sepia', label: 'Sepia', bg: '#F5EDDC', fg: '#33281C' },
  { id: 'night', label: 'Night', bg: '#1C1813', fg: '#EEDFC4' },
  { id: 'dark', label: 'Dark', bg: '#16191D', fg: '#EFEDE8' },
  { id: 'black', label: 'Black', bg: '#000000', fg: '#E6E6E6' },
];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{pageTitle}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<meta property="og:type" content="website">
<meta property="og:site_name" content="EPBM Library">
<meta property="og:title" content={pageTitle}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={imageUrl}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="EPBM Library: plain-English study notes for EPBM-32">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={pageTitle}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={imageUrl}>
<meta name="theme-color" content="#FDFCF9">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Literata:ital,opsz,wght@0,7..72,400..700;1,7..72,400&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<script is:inline>
(function () {
  var d = document.documentElement, t, s, f;
  try { t = localStorage.getItem('theme'); s = localStorage.getItem('size'); f = localStorage.getItem('font'); } catch (e) {}
  if (!t) t = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  d.dataset.theme = t; if (s) d.dataset.size = s; if (f) d.dataset.font = f;
})();
</script>
<style is:global>
:root{
  --bg:#FDFCF9;--surface:#F3F1EB;--surface-2:#E9E6DD;--ink:#1A1C1E;--body:#2E3135;--muted:#5B6066;--line:#E0DDD5;
  --accent:#1F5F4A;--accent-soft:#E2EEE8;--on-accent:#FFFFFF;--trap:#8A3A12;--trap-soft:#F8E9DF;--good:#1F6B47;--bad:#A12D2D;
  --read:19px;--read-font:Literata,Georgia,serif;--display:Literata,Georgia,serif;--sans:Inter,system-ui,sans-serif;color-scheme:light}
:root[data-theme="sepia"]{--bg:#F5EDDC;--surface:#EBE1CB;--surface-2:#E1D4B8;--ink:#33281C;--body:#43362A;--muted:#6A5840;--line:#DCCFB4;
  --accent:#7A4A16;--accent-soft:#E9D9BC;--on-accent:#FFF8EC;--trap:#8E3B12;--trap-soft:#EBD3BE;--good:#4E6420;--bad:#9A2F22;color-scheme:light}
:root[data-theme="night"]{--bg:#1C1813;--surface:#27211A;--surface-2:#322A21;--ink:#EEDFC4;--body:#DCCBAE;--muted:#A8977C;--line:#3A3127;
  --accent:#E3A857;--accent-soft:#3A2E1E;--on-accent:#1C1813;--trap:#F2A06E;--trap-soft:#3B2A1E;--good:#C9C27E;--bad:#F09886;color-scheme:dark}
:root[data-theme="dark"]{--bg:#16191D;--surface:#1F2328;--surface-2:#282D33;--ink:#EFEDE8;--body:#D7D4CE;--muted:#A3A8AE;--line:#343A42;
  --accent:#8AD0B4;--accent-soft:#1E2F29;--on-accent:#0E1A16;--trap:#F0A77E;--trap-soft:#33261F;--good:#8AD0B4;--bad:#F2A0A0;color-scheme:dark}
:root[data-theme="black"]{--bg:#000000;--surface:#111111;--surface-2:#1A1A1A;--ink:#E6E6E6;--body:#CFCFCF;--muted:#9C9C9C;--line:#2A2A2A;
  --accent:#8AD0B4;--accent-soft:#132520;--on-accent:#06110D;--trap:#F0A77E;--trap-soft:#2A1D16;--good:#8AD0B4;--bad:#F2A0A0;color-scheme:dark}
:root[data-size="s"]{--read:17px}:root[data-size="l"]{--read:21px}:root[data-size="xl"]{--read:23px}
:root[data-font="sans"]{--read-font:Inter,system-ui,sans-serif}

*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:24px;-webkit-text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--sans);font-size:16px;line-height:1.5;-webkit-font-smoothing:antialiased;transition:background-color .2s,color .2s}
a{color:var(--accent);text-underline-offset:3px}a:hover{color:var(--ink)}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:4px}
::selection{background:var(--accent);color:var(--on-accent)}
.wrap{max-width:1120px;margin:0 auto;padding-left:32px;padding-right:32px}
@media (max-width:600px){.wrap{padding-left:20px;padding-right:20px}}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
h1,h2,h3{font-family:var(--display);color:var(--ink);font-optical-sizing:auto}

.top{border-bottom:1px solid var(--line)}
.top .wrap{display:flex;align-items:center;justify-content:space-between;gap:12px 20px;padding-top:12px;padding-bottom:12px}
.brand{display:flex;align-items:center;gap:10px;min-height:44px;text-decoration:none;color:var(--ink);font-family:var(--display);font-weight:600;font-size:22px;letter-spacing:-.01em}
.backlink{display:inline-flex;align-items:center;gap:8px;min-height:44px;text-decoration:none;color:var(--ink);font-weight:500;font-size:15px;min-width:0}
.backlink span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.tools{display:flex;align-items:center;gap:8px;flex:none}
.navlink{display:inline-flex;align-items:center;min-height:44px;padding:0 10px;text-decoration:none;color:var(--ink);font-weight:500;font-size:15px}
.iconbtn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;min-width:44px;padding:0 14px;border:1px solid var(--line);border-radius:8px;background:transparent;color:var(--ink);font:500 14px var(--sans);cursor:pointer;list-style:none;text-decoration:none}
.iconbtn::-webkit-details-marker{display:none}
.iconbtn:hover{border-color:var(--ink);color:var(--ink)}
.btn{display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:0 16px;border-radius:8px;background:var(--accent);color:var(--on-accent);text-decoration:none;font-weight:600;font-size:14px}
.btn:hover{color:var(--on-accent);filter:brightness(1.08)}
@media (max-width:600px){.btn .lbl,.iconbtn .lbl{display:none}.btn{padding:0 12px}}

.disp{position:relative}
.disp[open] > .iconbtn{border-color:var(--ink)}
.panel{position:absolute;right:0;top:calc(100% + 8px);z-index:20;width:300px;max-width:calc(100vw - 40px);padding:18px;background:var(--bg);border:1px solid var(--line);border-radius:12px;box-shadow:0 12px 32px rgba(0,0,0,.18)}
.panel h2{margin:0 0 10px;font:600 13px var(--sans);color:var(--muted)}
.panel .row + h2,.panel .swatches + h2{margin-top:18px}
.swatches{display:grid;grid-template-columns:repeat(5,1fr);gap:4px}
.sw{display:flex;flex-direction:column;align-items:center;gap:6px;padding:8px 0;border:1px solid transparent;border-radius:8px;background:transparent;color:var(--body);font:500 12px var(--sans);cursor:pointer}
.sw i{display:block;width:30px;height:30px;border-radius:50%;border:1px solid var(--line);font:600 13px/28px var(--display);font-style:normal;text-align:center}
.sw[aria-pressed="true"]{border-color:var(--ink);color:var(--ink)}
.row{display:flex;gap:6px}
.row .opt2{flex:1;min-height:44px;border:1px solid var(--line);border-radius:8px;background:transparent;color:var(--ink);font:500 14px var(--sans);cursor:pointer}
.row .opt2[aria-pressed="true"]{background:var(--ink);color:var(--bg);border-color:var(--ink)}
.panel .note{margin:14px 0 0;font-size:12px;line-height:1.45;color:var(--muted)}

.foot{border-top:1px solid var(--line);margin-top:80px}
.foot .wrap{display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px 32px;padding-top:28px;padding-bottom:36px;font-size:14px;color:var(--muted)}

/* reading */
.prose{font-family:var(--read-font);font-size:var(--read);line-height:1.72;color:var(--body);font-optical-sizing:auto}
.prose > *{margin:0 0 1.15em}
.prose h2{font-weight:600;font-size:1.55em;line-height:1.2;letter-spacing:-.01em;margin:2.4em 0 .7em}
.prose h3{font-weight:600;font-size:1.18em;line-height:1.3;margin:1.8em 0 .5em}
.prose strong{color:var(--ink);font-weight:650}
.prose ul,.prose ol{padding-left:1.25em}
.prose li{margin-bottom:.45em}
.prose li::marker{color:var(--muted)}
.prose table{display:table;width:100%;border-collapse:collapse;border:1px solid var(--line);border-radius:10px;font-family:var(--sans);font-size:15px;line-height:1.5}
.prose th{text-align:left;padding:12px 16px;background:var(--surface);color:var(--ink);font-weight:600;white-space:nowrap}
.prose td{padding:11px 16px;border-top:1px solid var(--line);vertical-align:top;min-width:140px}
.prose th + th,.prose td + td{border-left:1px solid var(--line)}
@media (max-width:760px){.prose table{display:block;overflow-x:auto}}
.prose figure{margin:2em 0}
.prose figcaption{font-family:var(--sans);font-size:13px;line-height:1.45;color:var(--muted);margin-top:10px}
.callout{padding:20px 22px;background:var(--surface);border-radius:12px;font-size:.94em}
.callout > *{margin:0 0 .7em}.callout > *:last-child{margin-bottom:0}
.callout-title{display:flex;align-items:center;gap:8px;font-family:var(--sans);font-size:13px;font-weight:600;letter-spacing:.02em;color:var(--accent)}
.callout.trap{background:var(--trap-soft)}
.callout.trap .callout-title{color:var(--trap)}
.callout.beyond{background:transparent;border:1px dashed var(--muted)}
.callout.beyond .callout-title{color:var(--muted)}
</style>
</head>
<body>
<header class="top">
  <div class="wrap">
    {back
      ? <a class="backlink" href={back.href}><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex:none"><path d="M19 12H5"/><path d="M11 6l-6 6 6 6"/></svg><span>{back.label}</span></a>
      : <a class="brand" href="/"><svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h6a2 2 0 0 1 2 2v12a2 2 0 0 0-2-2H4z"/><path d="M20 5h-6a2 2 0 0 0-2 2v12a2 2 0 0 1 2-2h6z"/></svg>EPBM Library</a>}
    <div class="tools">
      {!back && <a class="navlink" href="/editor/">Editor</a>}
      <details class="disp">
        <summary class="iconbtn" aria-label="Reading settings"><span aria-hidden="true" style="font-family:var(--display);font-size:17px;font-weight:600">Aa</span><span class="lbl">Display</span></summary>
        <div class="panel">
          <h2>Theme</h2>
          <div class="swatches">
            {themes.map((t) => (
              <button type="button" class="sw" data-theme-set={t.id} aria-pressed="false">
                <i style={`background:${t.bg};color:${t.fg}`} aria-hidden="true">A</i>{t.label}
              </button>
            ))}
          </div>
          <h2>Text size</h2>
          <div class="row">
            <button type="button" class="opt2" data-size-step="-1" aria-label="Smaller text">A−</button>
            <button type="button" class="opt2" data-size-step="1" aria-label="Larger text">A+</button>
          </div>
          <h2>Font</h2>
          <div class="row">
            <button type="button" class="opt2" data-font-set="serif" aria-pressed="true" style="font-family:var(--display)">Serif</button>
            <button type="button" class="opt2" data-font-set="sans" aria-pressed="false">Sans</button>
          </div>
          <p class="note">Night is a warm, low-blue theme for reading after dark. Your choices are remembered on this device.</p>
        </div>
      </details>
      {pdf && <a class="btn" href={pdf} download><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v11"/><path d="M7 11l5 5 5-5"/><path d="M5 20h14"/></svg><span class="lbl">Download PDF</span><span class="sr">(PDF)</span></a>}
    </div>
  </div>
</header>

<slot />

<footer class="foot">
  <div class="wrap">
    <span>An independent, student-run library, edited by <a href="/editor/">Abhinav Roy</a>. Not an official IIM Calcutta site.</span>
    <span>More from girder.in: <a href="https://brief.girder.in/">Industrial Cyber Brief</a> · <a href="https://girder.in/">Ferrum OT</a></span>
  </div>
</footer>

<script is:inline>
(function () {
  var root = document.documentElement;
  var meta = document.querySelector('meta[name="theme-color"]');
  var bgs = { light: '#FDFCF9', sepia: '#F5EDDC', night: '#1C1813', dark: '#16191D', black: '#000000' };
  function save(k, v) { try { localStorage.setItem(k, v); } catch (e) {} }
  function paint() {
    var t = root.dataset.theme || 'light', f = root.dataset.font || 'serif';
    document.querySelectorAll('[data-theme-set]').forEach(function (b) { b.setAttribute('aria-pressed', String(b.dataset.themeSet === t)); });
    document.querySelectorAll('[data-font-set]').forEach(function (b) { b.setAttribute('aria-pressed', String(b.dataset.fontSet === f)); });
    if (meta && bgs[t]) meta.setAttribute('content', bgs[t]);
  }
  document.querySelectorAll('[data-theme-set]').forEach(function (b) {
    b.addEventListener('click', function () { root.dataset.theme = b.dataset.themeSet; save('theme', b.dataset.themeSet); paint(); });
  });
  document.querySelectorAll('[data-font-set]').forEach(function (b) {
    b.addEventListener('click', function () { root.dataset.font = b.dataset.fontSet; save('font', b.dataset.fontSet); paint(); });
  });
  var sizes = ['s', 'm', 'l', 'xl'];
  document.querySelectorAll('[data-size-step]').forEach(function (b) {
    b.addEventListener('click', function () {
      var i = sizes.indexOf(root.dataset.size || 'm') + Number(b.dataset.sizeStep);
      i = Math.max(0, Math.min(sizes.length - 1, i));
      root.dataset.size = sizes[i]; save('size', sizes[i]);
    });
  });
  var disp = document.querySelector('.disp');
  document.addEventListener('click', function (e) { if (disp && disp.open && !disp.contains(e.target)) disp.open = false; });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && disp && disp.open) { disp.open = false; disp.querySelector('summary').focus(); } });
  paint();
})();
</script>
</body>
</html>
