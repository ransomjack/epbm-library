---
const { title, back, pdf, reading = false } = Astro.props;
const pageTitle = title ? `${title} · EPBM Library` : 'EPBM Library';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{pageTitle}</title>
<meta name="description" content="Study notes from EPBM-32, written in plain English. An independent, student-run library.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<script is:inline>
try {
  var t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t;
  var s = localStorage.getItem('size'); if (s) document.documentElement.dataset.size = s;
} catch (e) {}
</script>
<style is:global>
:root{--bg:#FFFFFF;--surface:#F5F4F0;--ink:#16181A;--body:#2A2D31;--muted:#5A5F66;--line:#DEDCD6;--accent:#1F5F4A;--on-accent:#FFFFFF;--trap:#8A3A12;--read:19px;
  --serif:Newsreader,Georgia,serif;--sans:Inter,system-ui,sans-serif;color-scheme:light}
:root[data-theme="dark"]{--bg:#15181C;--surface:#1E2227;--ink:#F1EFEA;--body:#D9D6D0;--muted:#A3A8AE;--line:#343A42;--accent:#8AD0B4;--on-accent:#0E1A16;--trap:#F0A77E;color-scheme:dark}
:root[data-theme="black"]{--bg:#000000;--surface:#101010;--ink:#F2F2F2;--body:#D6D6D6;--muted:#A0A0A0;--line:#2A2A2A;--accent:#8AD0B4;--on-accent:#06110D;--trap:#F0A77E;color-scheme:dark}
:root[data-size="s"]{--read:17px}:root[data-size="l"]{--read:22px}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:24px}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--sans);font-size:16px;line-height:1.5}
a{color:var(--accent)}a:hover{color:var(--ink)}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.wrap{max-width:1120px;margin:0 auto;padding-left:32px;padding-right:32px}
@media (max-width:600px){.wrap{padding-left:20px;padding-right:20px}}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}

.top{border-bottom:1px solid var(--line)}
.top .wrap{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px 24px;padding-top:14px;padding-bottom:14px}
.brand{display:flex;align-items:center;gap:10px;min-height:44px;text-decoration:none;color:var(--ink);font-family:var(--serif);font-weight:600;font-size:23px}
.backlink{display:inline-flex;align-items:center;gap:8px;min-height:44px;text-decoration:none;color:var(--ink);font-weight:500;font-size:15px}
.tools{display:flex;flex-wrap:wrap;align-items:center;gap:12px}
.segs{display:flex;border:1px solid var(--line);border-radius:8px;overflow:hidden}
.seg{min-height:44px;min-width:44px;padding:0 14px;border:0;background:transparent;color:var(--muted);font:500 14px var(--sans);cursor:pointer}
.seg[aria-pressed="true"]{background:var(--ink);color:var(--bg)}
.btn{display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:0 18px;border-radius:8px;background:var(--accent);color:var(--on-accent);text-decoration:none;font-weight:600;font-size:14px}
.btn:hover{color:var(--on-accent);opacity:.9}

.foot{border-top:1px solid var(--line);margin-top:72px}
.foot .wrap{display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px 32px;padding-top:28px;padding-bottom:28px;font-size:14px;color:var(--muted)}

h1,h2,h3{font-family:var(--serif);color:var(--ink)}
.prose{font-family:var(--serif);font-size:var(--read);line-height:1.7;color:var(--body)}
.prose > *{margin:0 0 22px}
.prose h2{font-weight:600;font-size:1.65em;line-height:1.2;margin:48px 0 18px}
.prose h3{font-weight:600;font-size:1.25em;margin:32px 0 12px}
.prose strong{color:var(--ink);font-weight:600}
.prose ul,.prose ol{padding-left:1.2em}
.prose li{margin-bottom:10px}
.prose table{display:block;overflow-x:auto;width:100%;border-collapse:collapse;border:1px solid var(--line);border-radius:10px;font-family:var(--sans);font-size:15px;line-height:1.5}
.prose th{text-align:left;padding:13px 16px;background:var(--surface);color:var(--ink);font-weight:600;white-space:nowrap}
.prose td{padding:12px 16px;border-top:1px solid var(--line);vertical-align:top;min-width:140px}
.prose th + th,.prose td + td{border-left:1px solid var(--line)}
.prose img{max-width:100%;height:auto;border-radius:10px}
.prose figure{margin:0 0 22px}
.prose figcaption{font-family:var(--sans);font-size:13px;color:var(--muted);margin-top:8px}
.callout{padding:22px 24px;background:var(--surface);border-radius:10px}
.callout > *{margin:0 0 12px}.callout > *:last-child{margin-bottom:0}
.callout-title{font-family:var(--sans);font-size:13px;font-weight:600;letter-spacing:.02em;color:var(--accent)}
.callout.trap .callout-title{color:var(--trap)}
.callout.trap{border:1px solid var(--line)}
</style>
</head>
<body>
<header class="top">
  <div class="wrap">
    {back
      ? <a class="backlink" href={back.href}><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="M11 6l-6 6 6 6"/></svg>{back.label}</a>
      : <a class="brand" href="/"><svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h6a2 2 0 0 1 2 2v12a2 2 0 0 0-2-2H4z"/><path d="M20 5h-6a2 2 0 0 0-2 2v12a2 2 0 0 1 2-2h6z"/></svg>EPBM Library</a>}
    <div class="tools">
      {reading && (
        <div class="segs" role="group" aria-label="Text size">
          <button type="button" class="seg" data-size-step="-1" aria-label="Smaller text" style="font-size:13px">A</button>
          <button type="button" class="seg" data-size-step="1" aria-label="Larger text" style="font-size:18px">A</button>
        </div>
      )}
      <div class="segs" role="group" aria-label="Theme">
        <button type="button" class="seg" data-theme-set="light" aria-pressed="true">Light</button>
        <button type="button" class="seg" data-theme-set="dark" aria-pressed="false">Dark</button>
        <button type="button" class="seg" data-theme-set="black" aria-pressed="false">Black</button>
      </div>
      {pdf && <a class="btn" href={pdf} download><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v11"/><path d="M7 11l5 5 5-5"/><path d="M5 20h14"/></svg>Download PDF</a>}
    </div>
  </div>
</header>

<slot />

<footer class="foot">
  <div class="wrap">
    <span>An independent, student-run library. Not an official IIM Calcutta site.</span>
    <span>More from girder.in: <a href="https://brief.girder.in/">Industrial Cyber Brief</a> · <a href="https://girder.in/">Ferrum OT</a></span>
  </div>
</footer>

<script is:inline>
(function () {
  var root = document.documentElement;
  function save(k, v) { try { localStorage.setItem(k, v); } catch (e) {} }
  function paint() {
    var t = root.dataset.theme || 'light';
    document.querySelectorAll('[data-theme-set]').forEach(function (b) {
      b.setAttribute('aria-pressed', String(b.dataset.themeSet === t));
    });
  }
  document.querySelectorAll('[data-theme-set]').forEach(function (b) {
    b.addEventListener('click', function () { root.dataset.theme = b.dataset.themeSet; save('theme', b.dataset.themeSet); paint(); });
  });
  var sizes = ['s', 'm', 'l'];
  document.querySelectorAll('[data-size-step]').forEach(function (b) {
    b.addEventListener('click', function () {
      var i = sizes.indexOf(root.dataset.size || 'm') + Number(b.dataset.sizeStep);
      i = Math.max(0, Math.min(2, i));
      root.dataset.size = sizes[i]; save('size', sizes[i]);
    });
  });
  paint();
})();
</script>
</body>
</html>
