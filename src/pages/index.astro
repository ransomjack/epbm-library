---
import Base from '../layouts/Base.astro';
import Cover from '../components/Cover.astro';
import { library, chapters } from '../lib/books.js';

const live = library.filter((s) => s.chapters.length);
const soon = library.filter((s) => !s.chapters.length);
const totalQ = live.reduce((n, s) => n + s.questions, 0);
const totalTools = live.reduce((n, s) => n + s.tools, 0);
const top = [...live].sort((a, b) => b.tools - a.tools).slice(0, 2).map((s) => s.name);
const num = (n) => n.toLocaleString('en-IN');
const order = Object.fromEntries(live.map((s) => [s.slug, { n: s.name, q: !!s.quiz, c: s.chapters.map((c) => ({ u: `/${s.slug}/${c.slug}/`, t: `${c.kicker}: ${c.title}` })) }]));

---
<Base>
<main class="home">
  <section class="wrap hm-hero">
    <div class="hm-pitch">
      <h1>The EPBM-32 class notes, complete and interactive.</h1>
      <p class="hm-sub">Every session of the programme, written up in plain English by <a href="/editor/">Abhinav Roy</a>: the full classroom explanation, worked examples you can try for yourself, and practice questions for each subject.</p>
      <form class="hm-search" role="search" onsubmit="return false">
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
        <label class="sr" for="q">Search the library</label>
        <input id="q" type="search" placeholder="Search any topic, for example break-even or inflation" autocomplete="off">
      </form>
      <ul id="results" class="hm-results" aria-live="polite"></ul>
      <p class="hm-count">{live.length} subjects, {chapters.length} chapters, {totalTools} interactive exercises and {num(totalQ)} practice questions.</p>
    </div>
  </section>

  <section class="wrap" id="resume" hidden>
    <a class="hm-resume" id="resume-link" href="/">
      <span class="hm-resume-l" id="resume-label">Continue reading</span>
      <span class="hm-resume-t" id="resume-title"></span>
      <span class="hm-resume-s" id="resume-subject"></span>
    </a>
  </section>

  <section class="wrap hm-how" aria-label="How the library works">
    <div class="hm-way">
      <svg aria-hidden="true" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h6a2 2 0 0 1 2 2v12a2 2 0 0 0-2-2H4z"/><path d="M20 5h-6a2 2 0 0 0-2 2v12a2 2 0 0 1 2-2h6z"/></svg>
      <h2>Read</h2>
      <p>Each subject is a book that follows the sessions in the order they were taught, with the concepts, examples and cases from class. Every chapter opens with what you'll take away.</p>
    </div>
    <div class="hm-way">
      <svg aria-hidden="true" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M4 7h10"/><path d="M18 7h2"/><circle cx="16" cy="7" r="2"/><path d="M4 17h3"/><path d="M11 17h9"/><circle cx="9" cy="17" r="2"/></svg>
      <h2>Try</h2>
      <p>Calculators, sorting exercises and "what would you do?" cards sit inside the chapters, so you test an idea the moment you meet it.</p>
    </div>
    <div class="hm-way">
      <svg aria-hidden="true" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.8 2.8L16 9.5"/></svg>
      <h2>Practise</h2>
      <p>Every subject ends with practice questions. Pick an answer and see straight away whether it's right, and why.</p>
    </div>
  </section>

  <section class="wrap hm-shelf">
    <h2 class="hm-h">Choose a subject</h2>
    <p class="hm-hint">Each book stands on its own, so start with whichever subject you need.</p>
    <div class="hm-books">
      {live.map((s) => (
        <a class="hm-book" href={`/${s.slug}/`} data-book={s.slug} data-n={s.chapters.length}>
          <Cover s={s} />
          <span class="hm-book-body">
            <span class="hm-book-name">{s.name}</span>
            <span class="hm-book-blurb">{s.blurb}</span>
            <span class="hm-book-meta">
              <span>{s.chapters.length} chapters</span>
              <span>{s.minutes} min</span>
              {s.tools > 0 && <span>{s.tools} to try</span>}
              <span>{s.questions} questions</span>
            </span>
            <span class="hm-book-prog" hidden><span class="hm-book-bar"><i></i></span><span class="hm-book-pt"></span></span>
          </span>
        </a>
      ))}
      {soon.map((s) => (
        <div class="hm-book hm-book-soon">
          <Cover s={s} />
          <span class="hm-book-body">
            <span class="hm-book-name">{s.name}</span>
            <span class="hm-book-blurb">This book is on its way.</span>
            <span class="hm-book-meta"><span class="hm-soon-pill">Coming soon</span></span>
          </span>
        </div>
      ))}
    </div>
  </section>

  <section class="wrap hm-sixty">
    <a class="hm-sixty-link" href="/60-second/">
      <span class="hm-sixty-k">A separate series</span>
      <span class="hm-sixty-t">60-Second Management</span>
      <span class="hm-sixty-s">One management idea per card, about a minute each. Finance, marketing, leadership, operations and more.</span>
    </a>
  </section>
</main>

<script type="application/json" id="book-order" set:html={JSON.stringify(order)}></script>
<script is:inline>
(function () {
  var data = null, loading = false;
  var q = document.getElementById('q'), out = document.getElementById('results');
  function el(tag, cls, text) { var e = document.createElement(tag); if (cls) e.className = cls; if (text != null) e.textContent = text; return e; }
  function load() {
    if (data || loading) return; loading = true;
    fetch('/search.json').then(function (r) { return r.json(); }).then(function (d) { data = d; run(); }, function () { loading = false; });
  }
  q.addEventListener('focus', load);
  q.addEventListener('input', function () { load(); run(); });
  function run() {
    if (!data) return;
    var words = q.value.toLowerCase().split(/\s+/).filter(Boolean);
    out.textContent = '';
    if (!words.length) return;
    var hits = data.filter(function (d) { return words.every(function (w) { return d.text.indexOf(w) !== -1; }); });
    if (!hits.length) { out.appendChild(el('li', 'none', 'Nothing found. Try one word, such as “inventory” or “ratios”.')); return; }
    var phrase = q.value.toLowerCase().trim();
    var has = function (t) { t = t.toLowerCase(); return words.every(function (w) { return t.indexOf(w) !== -1; }); };
    var rank = function (h) { return has(h.title) ? 4 : h.heads.some(function (x) { return has(x.t); }) ? 3 : h.lead.indexOf(phrase) !== -1 ? 2 : 1; };
    hits.sort(function (a, b) { return rank(b) - rank(a); });
    hits.slice(0, 6).forEach(function (h) {
      var li = el('li'), a = el('a', null, h.title), url = h.url;
      var sec = h.heads.filter(function (x) { var t = x.t.toLowerCase(); return words.every(function (w) { return t.indexOf(w) !== -1; }); })[0];
      if (sec) url += '#' + sec.id;
      a.href = url; li.appendChild(a);
      li.appendChild(el('span', null, (sec ? 'Section: ' + sec.t + ' · ' : '') + h.subject + ', ' + h.kicker));
      out.appendChild(li);
    });
  }
  document.addEventListener('keydown', function (e) {
    if (e.key === '/' && document.activeElement.tagName !== 'INPUT') { e.preventDefault(); q.focus(); }
  });
  var st = window.EPBM;
  if (st) {
    var read = st.read(), last = st.last(), order = {};
    try { order = JSON.parse(document.getElementById('book-order').textContent); } catch (e) {}
    if (last && last.u) {
      var slug = last.u.split('/')[1], book = order[slug], go = { u: last.u, t: last.t, l: 'Continue reading' };
      if (book) {
        var urls = book.c.map(function (c) { return c.u; }), i = urls.indexOf(last.u);
        var unread = function (c) { return read.indexOf(c.u) === -1; };
        if (i !== -1 && !unread(book.c[i])) {
          var nx = book.c.slice(i + 1).filter(unread)[0] || book.c.filter(unread)[0];
          if (nx) go = { u: nx.u, t: nx.t, l: 'Up next' };
          else if (book.q) go = { u: '/' + slug + '/quiz/', t: 'Test yourself: ' + book.n + ' practice questions', l: 'Book finished' };
          else go = null;
        }
        var done = book.c.filter(function (c) { return read.indexOf(c.u) !== -1; }).length;
        if (go) go.s = book.n + (done ? ', ' + done + ' of ' + book.c.length + ' chapters read' : '');
      } else go.s = last.s;
      if (go) {
        document.getElementById('resume').hidden = false;
        document.getElementById('resume-link').href = go.u;
        document.getElementById('resume-label').textContent = go.l;
        document.getElementById('resume-title').textContent = go.t;
        document.getElementById('resume-subject').textContent = go.s;
      }
    }
    document.querySelectorAll('[data-book]').forEach(function (b) {
      var pre = '/' + b.dataset.book + '/', n = read.filter(function (u) { return u.indexOf(pre) === 0; }).length, tot = +b.dataset.n;
      if (!n) return;
      var p = b.querySelector('.hm-book-prog'); p.hidden = false;
      p.querySelector('i').style.width = Math.min(100, 100 * n / tot) + '%';
      p.querySelector('.hm-book-pt').textContent = n >= tot ? 'All ' + tot + ' read' : n + ' of ' + tot + ' read';
    });
  }
})();
</script>

<style is:global>
.hm-hero{padding-top:72px;padding-bottom:56px}
.hm-pitch{max-width:780px}
.hm-pitch h1{margin:0;font-weight:500;font-size:clamp(36px,5.2vw,62px);line-height:1.04;letter-spacing:-.018em;text-wrap:balance}
.hm-sub{margin:22px 0 28px;max-width:34em;font-size:18px;line-height:1.6;color:var(--body)}
.hm-sub a{color:var(--accent);font-weight:600;text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:3px}
.hm-search{display:flex;align-items:center;gap:10px;max-width:520px;padding:4px 16px;border:1.5px solid var(--ink);border-radius:12px;color:var(--muted);background:var(--bg)}
.hm-search:focus-within{outline:2px solid var(--accent);outline-offset:2px}
.hm-search input{flex:1;min-width:0;min-height:50px;border:0;outline:0;background:transparent;font:inherit;font-size:16px;color:var(--ink)}
.hm-results{list-style:none;margin:8px 0 0;padding:0;max-width:520px}
.hm-results li{display:flex;flex-direction:column;gap:2px;padding:11px 4px;border-bottom:1px solid var(--line);font-size:13px;color:var(--muted)}
.hm-results a{font-family:var(--display);font-size:18px;font-weight:500;color:var(--ink);text-decoration:none}
.hm-results a:hover{color:var(--accent)}
.hm-count{margin:18px 0 0;font-size:14px;color:var(--muted)}
.hm-resume{display:grid;grid-template-columns:auto 1fr;gap:2px 20px;align-items:baseline;padding:18px 22px;margin-bottom:48px;border:1.5px solid var(--accent);border-radius:14px;background:var(--accent-soft);text-decoration:none;color:var(--ink)}
.hm-resume:hover{color:var(--ink);border-color:var(--ink)}
.hm-resume-l{grid-row:1 / span 2;align-self:center;font-size:14px;font-weight:600;color:var(--accent)}
.hm-resume-t{font-family:var(--display);font-size:21px;font-weight:500;line-height:1.25}
.hm-resume-s{font-size:14px;color:var(--muted)}
.hm-how{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0;padding-top:0;padding-bottom:0}
.hm-way{padding:28px 28px 28px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.hm-way + .hm-way{padding-left:28px;border-left:1px solid var(--line)}
.hm-way svg{color:var(--accent)}
.hm-way h2{margin:10px 0 6px;font-weight:600;font-size:22px}
.hm-way p{margin:0;font-size:15px;line-height:1.55;color:var(--body)}
.hm-shelf{padding-top:64px}
.hm-sixty{padding-top:56px}
.hm-sixty-link{display:flex;flex-direction:column;gap:4px;padding:24px 28px;border:1px solid var(--line);border-radius:14px;background:var(--surface);color:var(--ink);text-decoration:none}
.hm-sixty-link:hover{border-color:var(--accent);color:var(--ink)}
.hm-sixty-k{font-size:12px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
.hm-sixty-t{font-family:var(--display);font-size:24px;font-weight:600}
.hm-sixty-s{font-size:15px;line-height:1.5;color:var(--body)}
.hm-h{margin:0;font-weight:500;font-size:clamp(28px,3.4vw,36px);letter-spacing:-.01em}
.hm-hint{margin:8px 0 28px;font-size:16px;color:var(--muted);max-width:44em}
.hm-books{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}
.hm-book{display:flex;gap:20px;align-items:stretch;padding:18px;border:1px solid var(--line);border-radius:14px;text-decoration:none;color:var(--ink);background:var(--bg);transition:border-color .15s,transform .15s}
.hm-book:hover{border-color:var(--ink);color:var(--ink)}
.hm-book .cover{transition:transform .2s}
.hm-book:hover .cover{transform:translateY(-3px) rotate(-1.2deg)}
.hm-book-body{display:flex;flex-direction:column;gap:8px;min-width:0;flex:1}
.hm-book-name{font-family:var(--display);font-weight:600;font-size:22px;line-height:1.2}
.hm-book-blurb{font-size:14.5px;line-height:1.5;color:var(--body)}
.hm-book-meta{display:flex;flex-wrap:wrap;gap:6px;margin-top:auto;padding-top:6px}
.hm-book-meta span{padding:3px 9px;border-radius:999px;background:var(--surface);font-size:12.5px;font-weight:500;color:var(--body);white-space:nowrap}
.hm-book-prog{display:flex;align-items:center;gap:10px}
.hm-book-prog[hidden]{display:none}
.hm-book-bar{flex:1;display:block;height:4px;border-radius:2px;background:var(--surface-2);overflow:hidden}
.hm-book-bar i{display:block;height:100%;background:var(--accent);border-radius:2px}
.hm-book-pt{font-size:13px;font-weight:600;color:var(--accent);white-space:nowrap}
.hm-book-soon{border-style:dashed}
.hm-book-soon .cover{filter:grayscale(.75);opacity:.6}
.hm-book-soon .hm-book-name{color:var(--muted)}
.hm-book-meta .hm-soon-pill{background:var(--surface-2);color:var(--body);font-weight:600}
@media (max-width:980px){
  .hm-hero{padding-top:44px;padding-bottom:44px}
}
@media (max-width:820px){.hm-books{grid-template-columns:1fr}}
@media (max-width:700px){
  .hm-how{grid-template-columns:1fr}
  .hm-way{padding:20px 0;border-bottom:0;display:grid;grid-template-columns:28px 1fr;gap:2px 14px}
  .hm-way + .hm-way{padding-left:0;border-left:0}
  .hm-way:last-child{border-bottom:1px solid var(--line)}
  .hm-way svg{grid-row:1 / span 2;margin-top:2px}.hm-way h2{margin:0;font-size:20px}
  .hm-shelf{padding-top:44px}
  .hm-resume{grid-template-columns:1fr;margin-bottom:36px}.hm-resume-l{grid-row:auto}
}
@media (max-width:520px){
  .hm-hero{padding-top:32px}
  .hm-sub{font-size:17px;margin:16px 0 22px}
  .hm-book{gap:14px;padding:14px}
  .hm-book-name{font-size:19px}.hm-book-blurb{font-size:14px}
}
@media (prefers-reduced-motion:reduce){.hm-book .cover{transition:none}.hm-book:hover .cover{transform:none}}
</style>
</Base>
