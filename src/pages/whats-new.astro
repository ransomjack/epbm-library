---
import Base from '../layouts/Base.astro';
import { updates } from '../data/whatsnew.js';
---
<Base title="What's new" back={{ href: '/', label: 'EPBM Library' }} description="New subjects, chapters and tools added to EPBM Library.">
<main class="wrap wn">
  <div class="kicker">What's new</div>
  <h1>Latest additions</h1>
  <ol>
    {updates.map((u) => <li><time>{u.date}</time><a href={u.href}>{u.title}</a><span>{u.body}</span></li>)}
  </ol>
</main>
<style>
.wn{max-width:760px;padding-top:56px}
.kicker{font:600 14px var(--sans);color:var(--accent)}
h1{margin:8px 0 28px;font-weight:500;font-size:clamp(34px,5vw,48px);line-height:1.1}
ol{list-style:none;margin:0;padding:0}
li{display:flex;flex-direction:column;gap:4px;padding:18px 0;border-top:1px solid var(--line);font-family:var(--sans)}
time{font-size:13px;color:var(--muted)}
li a{font:600 20px var(--display);color:var(--ink);text-decoration:none}
li a:hover{color:var(--accent)}
li span{font-size:15px;color:var(--body)}
</style>
</Base>
