---
import Base from '../../layouts/Base.astro';
import { library } from '../../lib/books.js';

export function getStaticPaths() {
  return library.filter((s) => s.quiz).map((s) => ({ params: { subject: s.slug }, props: { s } }));
}
const { s } = Astro.props;
const total = s.quiz.sections.reduce((n, x) => n + x.questions.length, 0);
---
<Base title={`Practice questions · ${s.name}`} back={{ href: `/${s.slug}/`, label: s.name }} image={s.og} description={`Test yourself on ${s.name}: ${total} practice questions with instant answers and explanations.`}>
<main class="wrap quiz" data-subject={s.name} data-color={s.color}>
  <header class="head">
    <div class="kicker">Practice</div>
    <h1>{total} practice questions</h1>
    <p class="lede">Pick an answer to see whether it is right and why. Your score stays on your device. At the end you can share it, if you like.</p>
  </header>

  <div class="sets" role="group" aria-label="Question set" id="sets"></div>

  <section id="card" class="card" aria-live="polite"></section>
  <noscript><p>This quiz needs JavaScript. The questions and answers are also in the PDF.</p></noscript>
</main>

<script type="application/json" id="quiz-data" set:html={JSON.stringify(s.quiz).replace(/</g, '\\u003c')}></script>
<script is:inline>
(function () {
  var data = JSON.parse(document.getElementById('quiz-data').textContent);
  var sets = [{ name: 'All questions', questions: [].concat.apply([], data.sections.map(function (s) { return s.questions; })) }]
    .concat(data.sections);
  var tagText = { PPT: 'From the slides', READING: 'From the reading', NEW: 'Extra question', CROSS: 'Cross-topic', TF: 'True or false', MCQ: 'Multiple choice', BANK: 'Question bank', CLASS: 'From class discussion' };
  var setsEl = document.getElementById('sets'), card = document.getElementById('card');
  var cur, i, score, answered;

  function el(tag, cls, text) { var e = document.createElement(tag); if (cls) e.className = cls; if (text != null) e.textContent = text; return e; }

  sets.forEach(function (s, k) {
    var b = el('button', 'set', s.name + ' (' + s.questions.length + ')');
    b.type = 'button';
    b.addEventListener('click', function () { start(k); });
    setsEl.appendChild(b);
  });

  function start(k) {
    cur = sets[k]; i = 0; score = 0;
    Array.prototype.forEach.call(setsEl.children, function (b, j) { b.setAttribute('aria-pressed', String(j === k)); });
    show();
  }

  function show() {
    var q = cur.questions[i]; answered = false;
    card.textContent = '';
    var meta = el('div', 'meta');
    meta.appendChild(el('span', null, 'Question ' + (i + 1) + ' of ' + cur.questions.length));
    meta.appendChild(el('span', null, tagText[q.tag] || ''));
    card.appendChild(meta);
    var bar = el('div', 'bar'); var fill = el('div', 'fill'); fill.style.width = (100 * i / cur.questions.length) + '%'; bar.appendChild(fill); card.appendChild(bar);
    card.appendChild(el('h2', 'q', q.q));
    var list = el('div', 'opts');
    q.options.forEach(function (text, k) {
      var b = el('button', 'opt'); b.type = 'button';
      b.appendChild(el('span', 'letter', 'ABCD'[k]));
      b.appendChild(el('span', 'text', text));
      b.addEventListener('click', function () { answer(k, list, q); });
      list.appendChild(b);
    });
    card.appendChild(list);
  }

  function answer(k, list, q) {
    if (answered) return; answered = true;
    var right = k === q.answer; if (right) score++;
    Array.prototype.forEach.call(list.children, function (b, j) {
      b.disabled = true;
      if (j === q.answer) { b.classList.add('right'); b.appendChild(el('span', 'mark', 'Correct answer')); }
      else if (j === k) { b.classList.add('wrong'); b.appendChild(el('span', 'mark', 'Your answer')); }
    });
    var why = el('div', 'why ' + (right ? 'ok' : 'no'));
    why.appendChild(el('p', 'verdict', right ? 'Correct.' : 'Not quite.'));
    why.appendChild(el('p', null, q.why));
    card.appendChild(why);
    var last = i === cur.questions.length - 1;
    var next = el('button', 'next', last ? 'See your score' : 'Next question'); next.type = 'button';
    next.addEventListener('click', function () { if (last) done(); else { i++; show(); window.scrollTo({ top: card.offsetTop - 16 }); } });
    card.appendChild(next); next.focus();
  }

  function done() {
    card.textContent = '';
    card.appendChild(el('div', 'meta', cur.name));
    card.appendChild(el('h2', 'q', 'You got ' + score + ' of ' + cur.questions.length + ' right.'));
    var pct = Math.round(100 * score / cur.questions.length);
    card.appendChild(el('p', 'pct', pct + '%' + (pct >= 80 ? ' · Strong result.' : pct >= 60 ? ' · Good going. Review the ones you missed.' : ' · Worth another read of the chapter, then try again.')));
    var again = el('button', 'next', 'Try this set again'); again.type = 'button';
    again.addEventListener('click', function () { i = 0; score = 0; show(); });
    card.appendChild(again);
    shareBlock(pct);
  }

  function shareBlock(pct) {
    var main = document.querySelector('.quiz');
    var subject = main.dataset.subject, color = main.dataset.color || '#1F4E5F';
    var total = cur.questions.length, setName = cur.name;
    var base = location.origin + location.pathname;
    var link = function (src) { return base + '?utm_source=' + src + '&utm_medium=score-share'; };
    var nameKey = 'epbm-name', name = '';
    try { name = localStorage.getItem(nameKey) || ''; } catch (e) {}

    var box = el('section', 'sharebox');
    box.appendChild(el('h3', 'sb-h', 'Share your score'));
    box.appendChild(el('p', 'sb-p', 'Add your name to put it on your score card. It stays on this device and is never sent anywhere.'));
    var lab = el('label', 'sb-lab'); lab.appendChild(el('span', null, 'Your name (optional)'));
    var inp = el('input'); inp.type = 'text'; inp.maxLength = 40; inp.autocomplete = 'name'; inp.value = name; inp.placeholder = 'For example, Priya Sharma';
    lab.appendChild(inp); box.appendChild(lab);

    var cv = document.createElement('canvas'); cv.width = 1200; cv.height = 630;
    var img = el('img', 'sb-card'); img.alt = 'Score card'; img.width = 1200; img.height = 630;
    box.appendChild(img);

    function msg() {
      var who = name.trim() ? name.trim() + ' scored ' : 'I scored ';
      return who + score + '/' + total + ' (' + pct + '%) on the ' + subject + ' practice questions in EPBM Library, the EPBM-32 class notes, free to read. Can you beat it?';
    }

    function fit(ctx, text, max, size, weight, family) {
      do { ctx.font = weight + ' ' + size + 'px ' + family; size -= 2; } while (ctx.measureText(text).width > max && size > 20);
    }
    function draw() {
      var ctx = cv.getContext('2d'), W = 1200, H = 630, serif = 'Literata, Georgia, serif', sans = 'Inter, system-ui, sans-serif';
      ctx.fillStyle = color; ctx.fillRect(0, 0, W, H);
      ctx.fillStyle = 'rgba(255,255,255,0.08)'; ctx.beginPath(); ctx.arc(W - 40, -40, 360, 0, Math.PI * 2); ctx.fill();
      ctx.fillStyle = '#fff'; ctx.textBaseline = 'alphabetic';
      ctx.font = '600 30px ' + serif; ctx.fillText('EPBM Library', 72, 100);
      ctx.fillStyle = 'rgba(255,255,255,0.75)'; ctx.font = '500 24px ' + sans; ctx.fillText('Practice score', 72, 150);
      ctx.fillStyle = '#fff'; fit(ctx, subject, 1056, 52, '500', serif); ctx.fillText(subject, 72, 222);
      if (setName !== 'All questions') { ctx.fillStyle = 'rgba(255,255,255,0.75)'; fit(ctx, setName, 1056, 26, '500', sans); ctx.fillText(setName, 72, 266); }
      ctx.fillStyle = '#fff'; ctx.font = '600 150px ' + serif; var sc = score + '/' + total; ctx.fillText(sc, 72, 440);
      var sw = ctx.measureText(sc).width; ctx.font = '600 56px ' + sans; ctx.fillText(pct + '%', 72 + sw + 36, 432);
      if (name.trim()) { fit(ctx, name.trim(), 1056, 40, '600', sans); ctx.fillText(name.trim(), 72, 512); }
      ctx.fillStyle = 'rgba(255,255,255,0.8)'; ctx.font = '500 24px ' + sans;
      ctx.fillText('library.girder.in  ·  EPBM-32 class notes, free to read', 72, 578);
      img.src = cv.toDataURL('image/png');
    }
    var t; inp.addEventListener('input', function () { name = inp.value; try { localStorage.setItem(nameKey, name); } catch (e) {} clearTimeout(t); t = setTimeout(draw, 150); });
    (document.fonts && document.fonts.ready ? document.fonts.ready : Promise.resolve()).then(draw);

    var row = el('div', 'share');
    function fileName() { return 'epbm-score-' + main.dataset.subject.toLowerCase().replace(/[^a-z]+/g, '-') + '.png'; }
    function blob(cb) { cv.toBlob(cb, 'image/png'); }
    if (navigator.canShare && window.File) {
      var sh = el('button', 'share-b primary', 'Share score card'); sh.type = 'button';
      sh.addEventListener('click', function () {
        blob(function (b) {
          var file = new File([b], fileName(), { type: 'image/png' });
          var payload = { files: [file], text: msg() + ' ' + link('share') };
          if (navigator.canShare(payload)) navigator.share(payload).catch(function () {});
          else navigator.share({ text: msg(), url: link('share') }).catch(function () {});
        });
      });
      row.appendChild(sh);
    }
    var dl = el('button', 'share-b', 'Download score card'); dl.type = 'button';
    dl.addEventListener('click', function () { blob(function (b) { var a = document.createElement('a'); a.href = URL.createObjectURL(b); a.download = fileName(); document.body.appendChild(a); a.click(); setTimeout(function () { URL.revokeObjectURL(a.href); a.remove(); }, 500); }); });
    row.appendChild(dl);
    var wa = el('a', 'share-b', 'WhatsApp'); wa.target = '_blank'; wa.rel = 'noopener';
    wa.addEventListener('click', function () { wa.href = 'https://wa.me/?text=' + encodeURIComponent(msg() + ' ' + link('whatsapp')); });
    wa.href = 'https://wa.me/?text=' + encodeURIComponent(msg() + ' ' + link('whatsapp')); row.appendChild(wa);
    var li = el('a', 'share-b', 'LinkedIn'); li.target = '_blank'; li.rel = 'noopener';
    var liHref = function () { return 'https://www.linkedin.com/feed/?shareActive=true&text=' + encodeURIComponent(msg() + ' ' + link('linkedin')); };
    li.href = liHref(); li.addEventListener('click', function () { li.href = liHref(); }); row.appendChild(li);
    var cp = el('button', 'share-b', 'Copy message'); cp.type = 'button';
    cp.addEventListener('click', function () { if (navigator.clipboard) navigator.clipboard.writeText(msg() + ' ' + link('copy')).then(function () { cp.textContent = 'Copied'; setTimeout(function () { cp.textContent = 'Copy message'; }, 1800); }); });
    row.appendChild(cp);
    inp.addEventListener('input', function () { wa.href = 'https://wa.me/?text=' + encodeURIComponent(msg() + ' ' + link('whatsapp')); li.href = liHref(); });
    box.appendChild(row);
    box.appendChild(el('p', 'sb-tip', 'Posting on LinkedIn? Download the score card first, then add it to your post as an image.'));
    card.appendChild(box);
  }

  start(0);
})();
</script>

<style is:global>
.quiz{max-width:800px;padding-top:56px}
.quiz .head .kicker{font-size:14px;font-weight:600;color:var(--accent)}
.quiz .head h1{margin:8px 0 0;font-weight:500;font-size:clamp(32px,5vw,46px);line-height:1.1}
.quiz .lede{margin:14px 0 0;font-size:16px;color:var(--muted)}
.sets{display:flex;flex-wrap:wrap;gap:8px;margin:28px 0}
.set{min-height:44px;padding:0 16px;border:1px solid var(--line);border-radius:999px;background:transparent;color:var(--body);font:500 14px var(--sans);cursor:pointer}
.set[aria-pressed="true"]{background:var(--ink);border-color:var(--ink);color:var(--bg)}
@media (max-width:600px){.quiz{padding-top:28px}.sets{flex-wrap:nowrap;overflow-x:auto;margin:22px -20px;padding:0 20px 6px;scrollbar-width:none}.sets::-webkit-scrollbar{display:none}.set{flex:none;white-space:nowrap}}
.card{border-top:1px solid var(--line);padding-top:24px}
.card .meta{display:flex;flex-wrap:wrap;justify-content:space-between;gap:8px;font-size:14px;font-weight:500;color:var(--muted)}
.bar{height:4px;margin:12px 0 28px;background:var(--surface);border-radius:2px}
.fill{height:4px;background:var(--accent);border-radius:2px}
.card .q{margin:0 0 24px;font-family:var(--display);font-weight:500;font-size:clamp(22px,3vw,27px);line-height:1.35}
.opts{display:flex;flex-direction:column;gap:10px}
.opt{display:flex;flex-wrap:wrap;align-items:baseline;gap:6px 14px;width:100%;min-height:56px;padding:14px 18px;border:1px solid var(--line);border-radius:10px;background:transparent;color:var(--ink);font:400 16px/1.45 var(--sans);text-align:left;cursor:pointer}
.opt:hover:not(:disabled){border-color:var(--ink)}
.opt:disabled{cursor:default;color:var(--muted)}
.opt .letter{font-weight:600;flex:none}
.opt .text{flex:1 1 240px}
.opt .mark{flex:none;font-size:13px;font-weight:600}
.opt.right{border:2px solid var(--good);color:var(--ink)}.opt.right .mark{color:var(--good)}
.opt.wrong{border:2px dashed var(--bad);color:var(--ink)}.opt.wrong .mark{color:var(--bad)}
.why{margin-top:20px;padding:20px 22px;background:var(--surface);border-radius:10px;font-family:var(--display);font-size:18px;line-height:1.6;color:var(--body)}
.why p{margin:0}
.why .verdict{font-family:var(--sans);font-size:14px;font-weight:600;margin-bottom:8px}
.why.ok .verdict{color:var(--good)}.why.no .verdict{color:var(--bad)}
.pct{margin:-8px 0 0;font:600 17px var(--sans);color:var(--accent)}
.share{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-top:32px;font-family:var(--sans)}
.share-l{font-size:14px;font-weight:600;color:var(--muted);margin-right:6px}
.share-b{display:inline-flex;align-items:center;min-height:40px;padding:0 14px;border:1px solid var(--line);border-radius:8px;background:var(--surface);color:var(--ink);font:600 14px var(--sans);text-decoration:none;cursor:pointer}
.share-b:hover{border-color:var(--accent);color:var(--accent)}
.share-b.primary{background:var(--accent);border-color:var(--accent);color:var(--on-accent)}
.sharebox{margin-top:36px;padding-top:28px;border-top:1px solid var(--line);font-family:var(--sans)}
.sb-h{margin:0;font:600 20px var(--display);color:var(--ink)}
.sb-p{margin:6px 0 18px;font-size:15px;color:var(--muted)}
.sb-lab{display:flex;flex-direction:column;gap:6px;max-width:360px;font-size:14px;font-weight:600;color:var(--body)}
.sb-lab input{min-height:44px;padding:0 14px;border:1px solid var(--line);border-radius:8px;background:var(--bg);color:var(--ink);font:400 16px var(--sans)}
.sb-lab input:focus{outline:2px solid var(--accent);outline-offset:1px}
.sb-card{display:block;width:100%;height:auto;margin:20px 0 0;border-radius:10px;box-shadow:0 1px 0 var(--line)}
.sharebox .share{margin-top:18px}
.sb-tip{margin:14px 0 0;font-size:14px;color:var(--muted)}
.next{margin-top:20px;min-height:48px;padding:0 22px;border:0;border-radius:8px;background:var(--accent);color:var(--on-accent);font:600 15px var(--sans);cursor:pointer}
</style>
</Base>
