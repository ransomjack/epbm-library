---
import Base from '../../layouts/Base.astro';
import { library } from '../../lib/books.js';

export function getStaticPaths() {
  return library.filter((s) => s.chapters.length).map((s) => ({ params: { subject: s.slug }, props: { s } }));
}
const { s } = Astro.props;
---
<Base title={s.name} pdf={s.pdf}>
<main class="wrap page">
  <nav class="side" aria-label="Subjects">
    <div class="side-title">Subjects</div>
    {library.map((x) => x.chapters.length
      ? <a class="subj" href={`/${x.slug}/`} aria-current={x.slug === s.slug ? 'page' : undefined}>{x.name}</a>
      : <span class="subj off">{x.name}</span>)}
  </nav>

  <div class="main">
    <div class="crumb"><a href="/">Library</a> &nbsp;/&nbsp; Subjects</div>
    <h1>{s.name}</h1>
    {s.blurb && <p class="lede">{s.blurb}</p>}

    <ol class="chapters">
      {s.chapters.map((c) => (
        <li>
          <a href={`/${s.slug}/${c.slug}/`}>
            <span class="kicker">{c.kicker}</span>
            <span class="ch-title">{c.title}</span>
          </a>
        </li>
      ))}
      {s.quiz && (
        <li>
          <a href={`/${s.slug}/quiz/`}>
            <span class="kicker">Practice</span>
            <span class="ch-title">{s.quiz.sections.reduce((n, x) => n + x.questions.length, 0)} practice MCQs</span>
          </a>
        </li>
      )}
      {(s.planned || []).map((p) => (
        <li class="planned"><span class="ch-title">{p}</span><span class="kicker">Being added</span></li>
      ))}
    </ol>
  </div>
</main>

<style>
.page{display:flex;flex-wrap:wrap;align-items:flex-start;gap:56px;padding-top:40px}
.side{flex:1 1 220px;min-width:0;display:flex;flex-direction:column;gap:2px}
.side-title{font-size:13px;font-weight:600;color:var(--muted);padding:0 12px 10px}
.subj{display:flex;align-items:center;min-height:44px;padding:8px 12px;border-radius:8px;text-decoration:none;color:var(--body);font-size:14px;line-height:1.3}
.subj[aria-current="page"]{background:var(--surface);color:var(--ink);font-weight:600}
.subj.off{color:var(--muted)}
.main{flex:999 1 560px;min-width:0}
.crumb{font-size:14px;color:var(--muted)}
h1{margin:16px 0 0;font-weight:500;font-size:clamp(32px,4.6vw,46px);line-height:1.1;letter-spacing:-0.01em}
.lede{margin:16px 0 0;font-size:17px;line-height:1.6;color:var(--body);max-width:660px}
.chapters{list-style:none;margin:32px 0 0;padding:0;border-top:1px solid var(--line)}
.chapters li{border-bottom:1px solid var(--line)}
.chapters a,.chapters .planned{display:flex;flex-direction:column;gap:2px;padding:16px 0;text-decoration:none}
.kicker{font-size:13px;font-weight:600;color:var(--muted)}
.ch-title{font-family:var(--serif);font-weight:500;font-size:22px;color:var(--ink)}
.chapters a:hover .ch-title{color:var(--accent)}
.planned .ch-title{color:var(--muted)}
</style>
</Base>
