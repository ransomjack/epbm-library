---
// The class export exercise: demand Q = 87 - 0.082 x dollar price; rival American item at 1,500 dollars.
---
<div class="calc" data-export>
  <div class="calc-in">
    <label class="ctl"><span>Rupees per dollar (2022: Rs. 82)</span><input type="range" min="76" max="92" step="1" value="84" data-k="e" /><output data-o="e"></output></label>
    <label class="ctl"><span>XYZ’s price in rupees (2022: Rs. 82,000)</span><input type="range" min="74000" max="96000" step="1000" value="82000" data-k="p" /><output data-o="p"></output></label>
    <div class="kv">
      <div><span>Buyer’s price in dollars</span><b data-v="usd"></b></div>
      <div><span>American rival’s price</span><b>$1,500</b></div>
      <div><span>Real exchange rate (2022: 1.50)</span><b data-v="rer"></b></div>
      <div><span>In real terms the rupee has</span><b data-v="dir"></b></div>
    </div>
  </div>
  <div class="calc-out"><span>Units the buyer takes (2022: 5)</span><b data-v="q"></b><span class="calc-note" data-v="note"></span></div>
</div>
<script>
  document.querySelectorAll('[data-export]').forEach((root) => {
    const $ = (s) => root.querySelector(s), set = (k, v) => { $(`[data-v="${k}"]`).textContent = v; };
    const run = () => {
      const e = Number($('[data-k="e"]').value), p = Number($('[data-k="p"]').value);
      $('[data-o="e"]').textContent = 'Rs. ' + e; $('[data-o="p"]').textContent = (p / 1000) + 'k';
      const usd = p / e, rer = e * 1500 / p, q = Math.max(0, Math.round(87 - 0.082 * usd));
      set('usd', '$' + Math.round(usd).toLocaleString('en-US')); set('rer', rer.toFixed(2));
      set('dir', rer > 1.505 ? 'Depreciated' : rer < 1.495 ? 'Appreciated' : 'Not moved'); set('q', q);
      const weaker = e > 82, stronger = e < 82;
      set('note', q === 0 ? (weaker ? 'The rupee fell and exports vanished: prices at home rose faster than the currency fell.' : 'At this dollar price the buyer takes nothing.')
        : rer > 1.505 ? (weaker ? 'A real depreciation: Indian goods are cheaper abroad, so more are sold.' : 'The price cut made Indian goods cheaper abroad, with no help from the currency.')
        : rer < 1.495 ? (weaker ? 'The rupee is weaker on paper, yet Indian goods became dearer abroad.' : 'Indian goods have become dearer abroad, so fewer are sold.')
        : 'Nothing has changed in real terms, so sales are where they were.');
    };
    root.querySelectorAll('input').forEach((x) => x.addEventListener('input', run)); run();
  });
</script>
