---
// Real, after-tax return on a deposit: (1 + i(1 - t)) / (1 + inflation) - 1.
---
<div class="calc" data-realrate>
  <div class="calc-in">
    <label class="ctl"><span>Interest rate on the deposit (nominal)</span><input type="range" min="2" max="12" step="0.25" value="7" data-k="i" /><output data-o="i"></output></label>
    <label class="ctl"><span>Inflation over the year</span><input type="range" min="0" max="12" step="0.25" value="5" data-k="p" /><output data-o="p"></output></label>
    <label class="ctl"><span>Tax on the interest</span><input type="range" min="0" max="30" step="10" value="30" data-k="t" /><output data-o="t"></output></label>
    <div class="kv">
      <div><span>Interest after tax</span><b data-v="net"></b></div>
      <div><span>Rule of thumb: rate minus inflation</span><b data-v="thumb"></b></div>
    </div>
  </div>
  <div class="calc-out"><span>Real return after tax</span><b data-v="real"></b><span class="calc-note" data-v="note"></span></div>
</div>
<script>
  document.querySelectorAll('[data-realrate]').forEach((root) => {
    const $ = (s) => root.querySelector(s), g = (k) => Number($(`[data-k="${k}"]`).value);
    const pc = (n) => (n > 0 ? '+' : n < 0 ? '−' : '') + Math.abs(n).toFixed(1) + '%';
    const run = () => {
      const i = g('i'), p = g('p'), t = g('t');
      $('[data-o="i"]').textContent = i + '%'; $('[data-o="p"]').textContent = p + '%'; $('[data-o="t"]').textContent = t + '%';
      const net = i * (1 - t / 100), real = ((1 + net / 100) / (1 + p / 100) - 1) * 100;
      $('[data-v="net"]').textContent = net.toFixed(1) + '%';
      $('[data-v="thumb"]').textContent = pc(net - p);
      $('[data-v="real"]').textContent = pc(Math.abs(real) < 0.05 ? 0 : real);
      $('[data-v="note"]').textContent = real < -0.05 ? 'The balance grew in rupees and shrank in what it can buy.' : real < 0.05 ? 'The saver has only kept pace with prices.' : 'The saver can buy more than a year ago.';
    };
    root.querySelectorAll('input').forEach((x) => x.addEventListener('input', run)); run();
  });
</script>
