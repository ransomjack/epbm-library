---
// Cost per task against agentic depth: flat salary line vs rising AI cost.
const W = 620, H = 260, L = 50, R = 20, T = 20, B = 46;
const x = (f) => L + f * (W - L - R), y = (f) => H - B - f * (H - T - B);
const f = (t) => 0.06 + 0.9 * Math.pow(t, 2.4);
let d = ''; for (let i = 0; i <= 50; i++) { const t = i / 50; d += `${i ? 'L' : 'M'}${x(t).toFixed(1)},${y(f(t)).toFixed(1)} `; }
const sal = 0.45, cross = Math.pow((sal - 0.06) / 0.9, 1 / 2.4);
const lab = 'fill:var(--muted);font:500 12px var(--sans)';
---
<svg class="pe" viewBox={`0 0 ${W} ${H}`} role="img" aria-label="AI cost per task starts below the cost of a salaried person and rises above it as tasks get deeper.">
  <rect x={x(cross)} y={y(1)} width={x(1) - x(cross)} height={y(0) - y(1)} style="fill:var(--trap-soft)" />
  <line x1={x(0)} y1={y(0)} x2={x(1)} y2={y(0)} style="stroke:var(--line)" /><line x1={x(0)} y1={y(0)} x2={x(0)} y2={y(1)} style="stroke:var(--line)" />
  <line x1={x(0)} y1={y(sal)} x2={x(1)} y2={y(sal)} style="stroke:var(--ink);stroke-width:2;stroke-dasharray:6 5" />
  <path d={d} style="fill:none;stroke:var(--accent);stroke-width:2.5" />
  <circle cx={x(cross)} cy={y(sal)} r="5" style="fill:var(--accent)" />
  <text x={x(0.02)} y={y(sal) - 8} style="fill:var(--ink);font:600 13px var(--sans)">Salaried person (fixed cost)</text>
  <text x={x(0.3)} y={y(0.32)} text-anchor="middle" style="fill:var(--accent);font:600 13px var(--sans)">AI is cheaper</text>
  <text x={x(0.3)} y={y(0.32) + 17} text-anchor="middle" style={lab}>simple, shallow tasks</text>
  <text x={x(0.97)} y={y(0.3)} text-anchor="end" style="fill:var(--trap);font:600 13px var(--sans)">People are cheaper</text>
  <text x={x(0.97)} y={y(0.3) + 17} text-anchor="end" style={lab}>long multi-step agent loops</text>
  <text x={x(0.5)} y={H - 12} text-anchor="middle" style={lab}>Depth of the task (steps the AI agent takes) →</text>
  <text x="16" y={y(0.5)} transform={`rotate(-90 16 ${y(0.5)})`} text-anchor="middle" style={lab}>Cost per task →</text>
</svg>
