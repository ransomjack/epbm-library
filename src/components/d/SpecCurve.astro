---
// Productivity rises with specialisation, flattens, then falls as human diseconomies set in.
const W = 640, H = 270, L = 50, R = 20, T = 40, B = 46;
const x = (f) => L + f * (W - L - R);
const y = (f) => H - B - f * (H - T - B);
const n = 60, pts = [];
for (let i = 0; i <= n; i++) { const t = i / n; pts.push([t, 0.08 + 0.9 * Math.exp(-Math.pow((t - 0.5) / 0.3, 2))]); }
const d = pts.map(([a, b], i) => `${i ? 'L' : 'M'}${x(a).toFixed(1)},${y(b).toFixed(1)}`).join(' ');
const lab = 'fill:var(--muted);font:500 12px var(--sans)';
---
<svg class="pe" viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Productivity rises with specialisation up to a peak, then declines.">
  <rect x={x(0.62)} y={y(1)} width={x(1) - x(0.62)} height={y(0) - y(1)} style="fill:var(--trap-soft)" />
  <line x1={x(0)} y1={y(0)} x2={x(1)} y2={y(0)} style="stroke:var(--line)" />
  <line x1={x(0)} y1={y(0)} x2={x(0)} y2={y(1)} style="stroke:var(--line)" />
  <path d={d} style="fill:none;stroke:var(--accent);stroke-width:2.5" />
  <text x={x(0.13)} y={y(0.86)} text-anchor="middle" style="fill:var(--ink);font:600 13px var(--sans)">Economies</text>
  <text x={x(0.13)} y={y(0.86) + 17} text-anchor="middle" style={lab}>tasks mastered faster</text>
  <text x={x(0.5)} y={y(0.98) - 10} text-anchor="middle" style="fill:var(--accent);font:600 13px var(--sans)">Optimum</text>
  <text x={x(0.99)} y={y(0.9)} text-anchor="end" style="fill:var(--trap);font:600 13px var(--sans)">Human diseconomies</text>
  <text x={x(0.99)} y={y(0.9) + 18} text-anchor="end" style={lab}>boredom, errors,</text>
  <text x={x(0.99)} y={y(0.9) + 34} text-anchor="end" style={lab}>absence, turnover</text>
  <text x={x(0.5)} y={H - 18} text-anchor="middle" style={lab}>Work specialisation →</text>
  <text x="14" y={y(0.5)} transform={`rotate(-90 14 ${y(0.5)})`} text-anchor="middle" style={lab}>Productivity →</text>
</svg>
