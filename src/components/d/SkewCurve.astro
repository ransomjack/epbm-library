---
// Pilgrim Bank: cumulative share of profit against cumulative share of customers (most profitable first).
const W = 620, H = 290, L = 54, R = 20, T = 20, B = 46;
const x = (v) => L + v / 100 * (W - L - R), y = (v) => H - B - v / 130 * (H - T - B);
const pts = [[0, 0], [1, 14], [3, 33], [6, 52], [10, 69], [15, 86], [20, 97], [30, 110], [40, 118], [53, 121.6], [65, 119.5], [80, 113], [90, 107.5], [100, 100]];
const d = pts.map(([a, b], i) => `${i ? 'L' : 'M'}${x(a).toFixed(1)},${y(b).toFixed(1)}`).join(' ');
const lab = 'fill:var(--muted);font:500 12px var(--sans)';
---
<svg class="pe" viewBox={`0 0 ${W} ${H}`} role="img" aria-label="The top 10% of customers bring 69% of profit and the top 20% bring 97%. The curve peaks at 121.6% at 53% of customers, then falls back to 100% as loss-making customers are added.">
  <rect x={x(53)} y={y(130)} width={x(100) - x(53)} height={y(0) - y(130)} style="fill:var(--trap-soft)" />
  <line x1={x(0)} y1={y(0)} x2={x(100)} y2={y(0)} style="stroke:var(--line)" /><line x1={x(0)} y1={y(0)} x2={x(0)} y2={y(130)} style="stroke:var(--line)" />
  <line x1={x(0)} y1={y(100)} x2={x(100)} y2={y(100)} style="stroke:var(--muted);stroke-dasharray:4 4" />
  {[0, 50, 100].map((v) => <text x={L - 8} y={y(v) + 4} text-anchor="end" style={lab}>{v}%</text>)}
  {[0, 20, 40, 60, 80, 100].map((v) => <text x={x(v)} y={H - 26} text-anchor="middle" style={lab}>{v}%</text>)}
  <path d={d} style="fill:none;stroke:var(--accent);stroke-width:2.5;stroke-linejoin:round" />
  {[[10, 69, 'Top 10% → 69%'], [20, 97, 'Top 20% → 97%']].map(([a, b, t]) => <><circle cx={x(a)} cy={y(b)} r="5" style="fill:var(--accent)" /><text x={x(a) + 10} y={y(b) + 14} style="fill:var(--ink);font:600 12px var(--sans)">{t}</text></>)}
  <circle cx={x(53)} cy={y(121.6)} r="5" style="fill:var(--ink)" />
  <text x={x(53) - 8} y={y(121.6) - 10} text-anchor="end" style="fill:var(--ink);font:600 12px var(--sans)">Peak: 121.6%</text>
  <text x={x(76.5)} y={y(60)} text-anchor="middle" style="fill:var(--trap);font:600 13px var(--sans)">Loss-making customers</text>
  <text x={x(76.5)} y={y(60) + 17} text-anchor="middle" style={lab}>pull the total back to 100%</text>
  <text x={x(50)} y={H - 6} text-anchor="middle" style={lab}>Share of customers, most profitable first →</text>
  <text x="14" y={y(65)} transform={`rotate(-90 14 ${y(65)})`} text-anchor="middle" style={lab}>Share of total profit →</text>
</svg>
