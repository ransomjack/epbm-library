---
// Benchmarking curve: value against cost, with a firm below the frontier.
const W = 620, H = 280, L = 50, R = 20, T = 20, B = 46;
const x = (f) => L + f * (W - L - R), y = (f) => H - B - f * (H - T - B);
const f = (t) => 0.1 + 0.82 * Math.sqrt(t);
let d = ''; for (let i = 0; i <= 50; i++) { const t = 0.03 + (0.95 - 0.03) * i / 50; d += `${i ? 'L' : 'M'}${x(t).toFixed(1)},${y(f(t)).toFixed(1)} `; }
const cx = 0.62, cy = 0.5, onx = Math.pow((cy - 0.1) / 0.82, 2);
const lab = 'fill:var(--muted);font:500 12px var(--sans)';
---
<svg class="pe" viewBox={`0 0 ${W} ${H}`} role="img" aria-label="A firm below the frontier can cut cost for the same value, or deliver more value for the same cost.">
  <line x1={x(0)} y1={y(0)} x2={x(1)} y2={y(0)} style="stroke:var(--line)" /><line x1={x(0)} y1={y(0)} x2={x(0)} y2={y(1)} style="stroke:var(--line)" />
  <path d={d} style="fill:none;stroke:var(--accent);stroke-width:2.5" />
  <text x={x(0.93)} y={y(f(0.93)) - 12} text-anchor="end" style="fill:var(--accent);font:600 13px var(--sans)">Industry frontier</text>
  <line x1={x(cx) - 9} y1={y(cy)} x2={x(onx) + 6} y2={y(cy)} style="stroke:var(--trap);stroke-width:2" marker-end="url(#fr-a)" />
  <line x1={x(cx)} y1={y(cy) - 9} x2={x(cx)} y2={y(f(cx)) + 6} style="stroke:var(--trap);stroke-width:2" marker-end="url(#fr-a)" />
  <defs><marker id="fr-a" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0,0 L10,5 L0,10 z" style="fill:var(--trap)" /></marker></defs>
  <circle cx={x(cx)} cy={y(cy)} r="7" style="fill:var(--ink)" />
  <text x={x(cx) + 12} y={y(cy) + 18} style="fill:var(--ink);font:600 13px var(--sans)">A firm below the frontier</text>
  <text x={x((cx + onx) / 2)} y={y(cy) + 18} text-anchor="middle" style="fill:var(--trap);font:600 12px var(--sans)">same value, less cost</text>
  <text x={x(cx) + 10} y={y((cy + f(cx)) / 2)} style="fill:var(--trap);font:600 12px var(--sans)">same cost, more value</text>
  <text x={x(0.5)} y={H - 12} text-anchor="middle" style={lab}>Cost of creating the value →</text>
  <text x="16" y={y(0.5)} transform={`rotate(-90 16 ${y(0.5)})`} text-anchor="middle" style={lab}>Value delivered →</text>
</svg>
