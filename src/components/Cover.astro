---
// A small book cover in the subject's colour.
const { s, size = 'm' } = Astro.props;
// Soft hyphens so long words break cleanly on a narrow cover.
const name = s.name.replace('Transformation', 'Transfor\u00ADmation').replace('Macroeconomic', 'Macro\u00ADeconomic').replace('Accounting', 'Account\u00ADing').replace('Excellence', 'Excel\u00ADlence').replace('Leadership', 'Leader\u00ADship').replace('Operational', 'Opera\u00ADtional').replace('Management', 'Manage\u00ADment');
---
<span class={`cover cover-${size}`} style={`--c:${s.color}`} aria-hidden="true">
  <span class="cover-t">{name}</span>
  <span class="cover-b">EPBM Library</span>
</span>
<style is:global>
.cover{align-self:flex-start;position:relative;display:flex;flex-direction:column;justify-content:space-between;flex:none;width:128px;aspect-ratio:3/4;padding:14px 12px 12px 20px;border-radius:3px 8px 8px 3px;background:var(--c);color:#fff;overflow:hidden;box-shadow:0 1px 0 rgba(0,0,0,.25),0 10px 22px -12px rgba(0,0,0,.55)}
.cover::before{content:"";position:absolute;inset:0 auto 0 0;width:9px;background:rgba(0,0,0,.22);border-right:1px solid rgba(255,255,255,.18)}
.cover::after{content:"";position:absolute;left:20px;right:12px;bottom:34px;height:1px;background:rgba(255,255,255,.35)}
.cover-t{font-family:var(--display);font-weight:600;font-size:14.5px;line-height:1.2;letter-spacing:-.005em;overflow-wrap:break-word;hyphens:manual}
.cover-b{font:500 10px var(--sans);opacity:.8}
.cover-l{width:176px;padding:20px 16px 16px 28px}
.cover-l::before{width:12px}.cover-l::after{left:28px;right:16px;bottom:42px}
.cover-l .cover-t{font-size:21px}.cover-l .cover-b{font-size:11px}
.cover-s{width:96px;padding:11px 9px 9px 16px}
.cover-s::before{width:7px}.cover-s::after{left:16px;right:9px;bottom:27px}
.cover-s .cover-t{font-size:12.5px}.cover-s .cover-b{font-size:8.5px}
@media (max-width:520px){
  .cover-m{width:100px;padding:11px 9px 9px 16px}.cover-m::before{width:7px}.cover-m::after{left:16px;right:9px;bottom:27px}
  .cover-m .cover-t{font-size:12.5px}.cover-m .cover-b{font-size:8.5px}
  .cover-l{width:124px;padding:14px 12px 12px 20px}.cover-l::before{width:9px}.cover-l::after{left:20px;right:12px;bottom:34px}
  .cover-l .cover-t{font-size:15px}.cover-l .cover-b{font-size:10px}
}
</style>
